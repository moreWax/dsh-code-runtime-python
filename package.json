{
  "name": "@morewax/dsh-code-runtime-python",
  "version": "0.1.0",
  "description": "uv-managed CPython process provider for the DeepSeek Harness CodeRuntime seam",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "python",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "python",
    "code-runtime",
    "uv"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moreWax/dsh-code-runtime-python.git"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --out-dir lib",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:python": "uv run --project python --locked --no-dev python -m py_compile python/bootstrap.py"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1",
    "@deepseek-ai/dsh-code-runtime-python": "0.1.1-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-code-runtime": "0.1.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-code-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-code-runtime-python": "0.1.1-rc.2",
    "@types/node": "^24.0.0",
    "tsdown": "^0.15.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "yaml": "^2.8.0"
  }
}
